{
  "name": "@radial-pulse/mobile",
  "version": "0.0.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "jest --passWithNoTests",
    "doctor": "expo install --check"
  },
  "nx": {
    "tags": [
      "type:app",
      "platform:native"
    ]
  },
  "dependencies": {
    "@expo-google-fonts/inter": "^0.4.2",
    "@radial-pulse/api-client": "workspace:*",
    "@radial-pulse/config": "workspace:*",
    "@radial-pulse/design-tokens": "workspace:*",
    "@radial-pulse/platform-shell": "workspace:*",
    "@radial-pulse/shared-types": "workspace:*",
    "@radial-pulse/ui": "workspace:*",
    "@radial-pulse/utils": "workspace:*",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@tanstack/react-query": "^5.85.0",
    "expo": "~54.0.0",
    "expo-constants": "~18.0.0",
    "expo-document-picker": "~14.0.8",
    "expo-font": "~14.0.12",
    "expo-linking": "~8.0.0",
    "expo-router": "~6.0.0",
    "expo-status-bar": "~3.0.0",
    "expo-web-browser": "~15.0.11",
    "lucide-react-native": "^1.48.0",
    "react": "19.1.0",
    "react-native": "0.81.5",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-svg": "15.12.1"
  },
  "devDependencies": {
    "@expo/metro-runtime": "~6.1.2",
    "@types/jest": "^29.5.14",
    "@types/react": "~19.1.10",
    "jest": "~29.7.0",
    "jest-expo": "~54.0.0",
    "react-dom": "19.1.0",
    "react-native-web": "^0.21.3"
  },
  "jest": {
    "preset": "jest-expo",
    "transformIgnorePatterns": [
      "node_modules/(?!((jest-)?react-native|@react-native(-community)?)|expo(nent)?|@expo(nent)?/.*|@expo-google-fonts/.*|react-navigation|@react-navigation/.*|@radial-pulse/.*|zod)"
    ],
    "moduleNameMapper": {
      "^lucide-react-native$": "<rootDir>/../../node_modules/lucide-react-native/dist/cjs/lucide-react-native.js"
    }
  }
}
