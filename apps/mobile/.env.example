# Mobile configuration is baked in per EAS build profile (eas.json sets APP_ENV;
# the EXPO_PUBLIC_* values are set as EAS environment variables per profile).
# Locally, copy to .env. Nothing here is secret: all values ship in the app.
EXPO_PUBLIC_APP_ENV=local
EXPO_PUBLIC_API_BASE_URL=https://api.dev.radialpulse.example
EXPO_PUBLIC_COGNITO_USER_POOL_ID=REPLACE_ME
EXPO_PUBLIC_COGNITO_USER_POOL_CLIENT_ID=REPLACE_ME
EXPO_PUBLIC_COGNITO_DOMAIN=REPLACE_ME
# Optional, space-separated; defaults to "openid email".
# EXPO_PUBLIC_COGNITO_SCOPES=openid email
EXPO_PUBLIC_API_MOCKING=false
