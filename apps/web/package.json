{
  "name": "@radial-pulse/web",
  "version": "0.0.0",
  "private": true,
  "description": "Radial Pulse Studio (V1): the internal staff-facing web application (Platform Administrators, Digital Success Managers).",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "generate-routes": "tsr generate",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run --passWithNoTests",
    "verify-bundle": "node scripts/verify-bundle.mjs"
  },
  "nx": {
    "tags": [
      "type:app",
      "platform:web"
    ],
    "targets": {
      "generate-routes": {
        "cache": true,
        "inputs": [
          "{projectRoot}/src/routes/**/*",
          "{projectRoot}/tsr.config.json",
          {
            "externalDependencies": [
              "@tanstack/router-cli",
              "@tanstack/router-generator"
            ]
          }
        ],
        "outputs": [
          "{projectRoot}/src/routeTree.gen.ts"
        ]
      },
      "build": {
        "dependsOn": [
          "generate-routes",
          "^build"
        ],
        "outputs": [
          "{projectRoot}/dist"
        ]
      },
      "typecheck": {
        "dependsOn": [
          "generate-routes"
        ]
      },
      "test": {
        "dependsOn": [
          "generate-routes"
        ]
      },
      "verify-bundle": {
        "dependsOn": [
          "build"
        ],
        "cache": true,
        "inputs": [
          "production",
          "^production"
        ]
      }
    }
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@radial-pulse/api-client": "workspace:*",
    "@radial-pulse/api-client-react": "workspace:*",
    "@radial-pulse/api-mocks": "workspace:*",
    "@radial-pulse/auth": "workspace:*",
    "@radial-pulse/config": "workspace:*",
    "@radial-pulse/design-tokens": "workspace:*",
    "@radial-pulse/shared-types": "workspace:*",
    "@radial-pulse/shell-core": "workspace:*",
    "@radial-pulse/utils": "workspace:*",
    "@radial-pulse/web-shell": "workspace:*",
    "@radial-pulse/web-ui": "workspace:*",
    "@tanstack/react-query": "^5.85.0",
    "@tanstack/react-router": "^1.131.0",
    "lucide-react": "^1.48.0",
    "msw": "^2.15.0",
    "react": "19.1.0",
    "react-dom": "19.1.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/router-cli": "^1.131.0",
    "@tanstack/router-plugin": "^1.131.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/react": "~19.1.10",
    "@types/react-dom": "~19.1.7",
    "@vitejs/plugin-react": "^5.0.0",
    "jsdom": "^26.1.0",
    "tailwindcss": "^4.3.3",
    "vite": "^7.1.0"
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  }
}
