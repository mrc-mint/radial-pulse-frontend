{
  "name": "@radial-pulse/web",
  "version": "0.0.0",
  "private": true,
  "description": "Radial Pulse Studio (V1): the internal staff-facing web application (Platform Administrators, Digital Success Managers).",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsr generate && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "typecheck": "tsr generate && tsc --noEmit -p tsconfig.json",
    "test": "tsr generate && vitest run --passWithNoTests"
  },
  "nx": {
    "tags": [
      "type:app",
      "platform:web"
    ]
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@radial-pulse/api-client": "workspace:*",
    "@radial-pulse/config": "workspace:*",
    "@radial-pulse/design-tokens": "workspace:*",
    "@radial-pulse/platform-shell": "workspace:*",
    "@radial-pulse/shared-types": "workspace:*",
    "@radial-pulse/ui": "workspace:*",
    "@radial-pulse/utils": "workspace:*",
    "@tanstack/react-query": "^5.85.0",
    "@tanstack/react-router": "^1.131.0",
    "lucide-react": "^1.48.0",
    "msw": "^2.15.0",
    "react": "19.1.0",
    "react-dom": "19.1.0"
  },
  "devDependencies": {
    "@tanstack/router-cli": "^1.131.0",
    "@tanstack/router-plugin": "^1.131.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/react": "~19.1.10",
    "@types/react-dom": "~19.1.7",
    "@vitejs/plugin-react": "^5.0.0",
    "jsdom": "^26.1.0",
    "vite": "^7.1.0"
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  }
}
