{
  "name": "@radial-pulse/ui-shared",
  "version": "0.0.0",
  "private": true,
  "description": "Platform-neutral UI contracts shared by web-ui and mobile-ui: prop contracts, status tones and display formatters. No DOM, no React Native.",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "lint": "eslint .",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run --passWithNoTests"
  },
  "nx": {
    "tags": [
      "type:ui",
      "platform:neutral"
    ]
  },
  "dependencies": {
    "@radial-pulse/design-tokens": "workspace:*",
    "@radial-pulse/shared-types": "workspace:*",
    "@radial-pulse/utils": "workspace:*"
  },
  "peerDependencies": {
    "react": "19.1.0"
  },
  "devDependencies": {
    "@types/react": "~19.1.10",
    "react": "19.1.0"
  }
}
